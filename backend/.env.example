# RetinaRetail — Backend Environment Variables
PORT=8000
HOST=0.0.0.0

# ESP32-CAM Configuration (Phase 3b)
# Put your ESP32-CAM module's IP address here (e.g. 192.168.1.50)
ESP32_CAM_IP=

# Or specify full stream URLs directly per camera:
# ESP32_STREAM_URL=http://192.168.1.50:81/stream
# CAM_1_STREAM_URL=http://192.168.1.50:81/stream
# CAM_2_STREAM_URL=
