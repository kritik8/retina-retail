# Supabase API Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend FastAPI Stream & Telemetry URL
# Local dev: http://localhost:8000 (default fallback)
# Production: set this to your hosted backend URL / Cloudflare Tunnel / Ngrok
VITE_API_URL=http://localhost:8000

# Cloudflare R2 — Camera Video Hosting
# Public bucket base URL (no trailing slash). Videos live at:
#   {R2_BASE}/CAM%20Videos/CAM%20{N}.mp4
# The hardcoded default in src/config/cameraConfig.ts matches the current bucket.
# Override here only if you move to a different bucket or custom domain.
# VITE_R2_BASE=https://pub-68d2604e65f74d62b6735ef7a371c82a.r2.dev
#
# CORS: Configure the R2 bucket to allow:
#   - https://your-app.pages.dev   (Cloudflare Pages production URL)
#   - http://localhost:5173         (Vite dev server)
# Dashboard -> R2 -> <bucket> -> Settings -> CORS policy
